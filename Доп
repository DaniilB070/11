int days_in_month(int mon, int year) {
    if (mon == 1) { /* февраль */
        if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0))
            return 29;
        return 28;
    }
    if (mon == 3 || mon == 5 || mon == 8 || mon == 10) return 30;
    return 31;
}

void task2_time(void) {
    time_t t;
    struct tm *mytime;
    char buf[120];
    char dayname[20], monthname[20], monthnom[20], roman[10];
    int year, mon, mday, hour, min, sec, wday, yday;
    int days_to_sun, hours_to_sun;
    int days_left_month, months_left_year;
    int season_day;
    int pair_start = 8 * 60;          /* первая пара в 8:00 */
    int pair_len = 90;                /* длительность пары 90 мин */
    int now_min, from_first, in_pair, rem_min, rem_sec;

    t = time(NULL);
    mytime = localtime(&t);

    year = mytime->tm_year + 1900;
    mon  = mytime->tm_mon;
    mday = mytime->tm_mday;
    hour = mytime->tm_hour;
    min  = mytime->tm_min;
    sec  = mytime->tm_sec;
    wday = mytime->tm_wday;
    yday = mytime->tm_yday;

    get_day_name(wday, dayname);
    get_month_name(mon, monthname);
    get_month_name_nom(mon, monthnom);
    get_roman_month(mon, roman);

    printf("\n");
    center_print("========================================");
    center_print("          ЗАДАНИЕ 2. ТЕКУЩЕЕ ВРЕМЯ          ");
    center_print("========================================");
    printf("\n");

    /* 1. Текущее время */
    sprintf(buf, "Московское время %02d:%02d:%02d", hour, min, sec);
    center_print(buf);

    /* 2. День недели словами */
    sprintf(buf, "Сегодня %s", dayname);
    center_print(buf);

    /* 3. День, месяц и год через разделитель */
    sprintf(buf, "%02d.%02d.%d", mday, mon + 1, year);
    center_print(buf);

    /* 4. День (цифра) и месяц (слово) */
    sprintf(buf, "%d %s", mday, monthname);
    center_print(buf);

    /* 5. сегодня N-й день k года */
    sprintf(buf, "сегодня %d-й день %d года", yday + 1, year);
    center_print(buf);

    /* 6. до воскресенья k дней и m часов */
    if (wday == 0) {
        days_to_sun = 0;
        hours_to_sun = 0;
    } else {
        days_to_sun = 7 - wday;
        hours_to_sun = (24 - hour - 1);
        if (min > 0 || sec > 0) hours_to_sun--;
        if (hours_to_sun < 0) {
            hours_to_sun += 24;
            days_to_sun--;
        }
    }
    sprintf(buf, "до воскресенья %d дней и %d часов", days_to_sun, hours_to_sun);
    center_print(buf);

    /* 7. с первой пары прошло k часов m минут (пара с 8:00) */
    now_min = hour * 60 + min;
    if (now_min >= pair_start) {
        from_first = now_min - pair_start;
        sprintf(buf, "с первой пары прошло %d часов %d минут", from_first / 60, from_first % 60);
    } else {
        sprintf(buf, "первая пара ещё не началась");
    }
    center_print(buf);

    /* 8. до Нового года осталось m месяцев и k дней */
    {
        int days_left = 0;
        int m;
        for (m = mon + 1; m < 12; m++)
            days_left += days_in_month(m, year);
        days_left += days_in_month(mon, year) - mday;
        months_left_year = 11 - mon;
        sprintf(buf, "до Нового года осталось %d месяцев и %d дней", months_left_year, days_left % 31);
    }
    center_print(buf);

    /* 9. до конца пары m минут и s секунд */
    now_min = hour * 60 + min;
    if (now_min >= pair_start) {
        in_pair = (now_min - pair_start) % pair_len;
        rem_min = pair_len - in_pair - 1;
        rem_sec = 60 - sec;
        if (rem_sec == 60) { rem_sec = 0; rem_min++; }
        if (rem_min < 0) rem_min = 0;
        sprintf(buf, "до конца пары %d минут и %d секунд", rem_min, rem_sec);
    } else {
        sprintf(buf, "сейчас не идёт пара");
    }
    center_print(buf);

    /* 10. до конца месяца d дней, до конца года m месяцев */
    days_left_month = days_in_month(mon, year) - mday;
    months_left_year = 11 - mon;
    sprintf(buf, "до конца месяца %d дней, до конца года %d месяцев", days_left_month, months_left_year);
    center_print(buf);

    /* 11. Месяц (римская цифра) и год */
    sprintf(buf, "%s %d", roman, year);
    center_print(buf);

    /* 12. Время года и две последние цифры года */
    {
        const char *season;
        if (mon == 11 || mon == 0 || mon == 1) season = "зима";
        else if (mon >= 2 && mon <= 4) season = "весна";
        else if (mon >= 5 && mon <= 7) season = "лето";
        else season = "осень";
        sprintf(buf, "%s %02d", season, year % 100);
        center_print(buf);
    }

    /* 13. идёт k день зимы/осени */
    if (mon == 11 || mon == 0 || mon == 1) {
        if (mon == 11) season_day = mday;
        else if (mon == 0) season_day = 31 + mday;
        else season_day = 31 + 31 + mday;
        sprintf(buf, "идёт %d день зимы", season_day);
    } else if (mon >= 8 && mon <= 10) {
        if (mon == 8) season_day = mday;
        else if (mon == 9) season_day = 30 + mday;
        else season_day = 30 + 31 + mday;
        sprintf(buf, "идёт %d день осени", season_day);
    } else {
        sprintf(buf, "сейчас не зима и не осень");
    }
    center_print(buf);

    printf("\n");
    center_print("****************************************");
}

