/* ==================== ЗАДАНИЕ 1: ТОЧКИ ==================== */

struct point {
    float x;
    float y;
    char name;
};

typedef struct point Point;

void put_point(Point z) {
    printf("Точка %c (%.1f, %.1f)\n", z.name, z.x, z.y);
}

float dist(Point z, Point w) {
    return sqrt((z.x - w.x)*(z.x - w.x) + (z.y - w.y)*(z.y - w.y));
}

Point mid(Point a, Point b) {
    Point m;
    m.x = (a.x + b.x) / 2.0f;
    m.y = (a.y + b.y) / 2.0f;
    m.name = 'M';
    return m;
}

int sameQuadrant(Point a, Point b) {
    if (a.x > 0 && a.y > 0 && b.x > 0 && b.y > 0) return 1;
    if (a.x < 0 && a.y > 0 && b.x < 0 && b.y > 0) return 1;
    if (a.x < 0 && a.y < 0 && b.x < 0 && b.y < 0) return 1;
    if (a.x > 0 && a.y < 0 && b.x > 0 && b.y < 0) return 1;
    return 0;
}

void task1_points(void) {
    Point a, b, m;

    printf("\n=== Задание 1. Работа с точками на плоскости ===\n\n");

    printf("Введите имя первой точки (одна буква): ");
    scanf(" %c", &a.name);
    printf("Введите координаты точки %c (x y): ", a.name);
    scanf("%f %f", &a.x, &a.y);

    printf("Введите имя второй точки (одна буква): ");
    scanf(" %c", &b.name);
    printf("Введите координаты точки %c (x y): ", b.name);
    scanf("%f %f", &b.x, &b.y);

    printf("\n--- Результаты ---\n");
    put_point(a);
    put_point(b);

    printf("Расстояние между точками: %.2f\n", dist(a, b));

    m = mid(a, b);
    printf("Средняя точка:\n");
    put_point(m);

    if (sameQuadrant(a, b))
        printf("Точки %c и %c лежат в одной четверти\n", a.name, b.name);
    else
        printf("Точки %c и %c лежат в разных четвертях\n", a.name, b.name);
}

/* ==================== ЗАДАНИЕ 2: ВРЕМЯ ==================== */

void center_print(const char *msg) {
    char line[81];
    int len = (int)strlen(msg);
    int pad = (80 - len) / 2;
    int i;

    /* левая часть звёздочек */
    for (i = 0; i < pad; i++) line[i] = '*';
    /* текст */
    for (i = 0; i < len; i++) line[pad + i] = msg[i];
    /* правая часть */
    for (i = pad + len; i < 80; i++) line[i] = '*';
    line[80] = '\0';

    printf("%s\n", line);
}

